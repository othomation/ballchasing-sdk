{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lucie/ballchasing-laravel",
    "description": "Laravel package for Ballchasing.com API integration",
    "version": "0.1.0",
    "keywords": ["laravel", "ballchasing", "rocket-league", "api", "sdk"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucie",
            "email": "lucie@parapluie.link"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Lucie\\BallchasingLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lucie\\BallchasingLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-unit": "vendor/bin/phpunit --testsuite=Unit",
        "test-integration": "vendor/bin/phpunit --configuration=phpunit.integration.xml",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "version": "echo \"Current version: $(grep '\"version\"' composer.json | cut -d'\"' -f4)\"",
        "version:patch": [
            "@version",
            "echo \"Updating patch version...\"",
            "php -r \"$c=json_decode(file_get_contents('composer.json'),1);$v=explode('.',$c['version']);$v[2]++;$c['version']=implode('.',$v);file_put_contents('composer.json',json_encode($c,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES));\"",
            "@version"
        ],
        "version:minor": [
            "@version",
            "echo \"Updating minor version...\"",
            "php -r \"$c=json_decode(file_get_contents('composer.json'),1);$v=explode('.',$c['version']);$v[1]++;$v[2]=0;$c['version']=implode('.',$v);file_put_contents('composer.json',json_encode($c,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES));\"",
            "@version"
        ],
        "version:major": [
            "@version",
            "echo \"Updating major version...\"",
            "php -r \"$c=json_decode(file_get_contents('composer.json'),1);$v=explode('.',$c['version']);$v[0]++;$v[1]=0;$v[2]=0;$c['version']=implode('.',$v);file_put_contents('composer.json',json_encode($c,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES));\"",
            "@version"
        ],
        "release": [
            "@test",
            "@format",
            "@analyse",
            "echo \"All checks passed. Ready for release!\""
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lucie\\BallchasingLaravel\\BallchasingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}