{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lucie/ballchasing-laravel",
    "description": "Laravel package for Ballchasing.com API integration",
    "keywords": ["laravel", "ballchasing", "rocket-league", "api", "sdk"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucie",
            "email": "lucie@parapluie.link"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Lucie\\BallchasingLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lucie\\BallchasingLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lucie\\BallchasingLaravel\\BallchasingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}